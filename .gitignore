# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual env
.venv/
venv/

# Env files
.env
.env.*
!.env.example

# Build artifacts
/dist/
/build/
*.egg-info/

# JS frontend / desktop (units 018-019): never commit installed packages or builds
node_modules/
apps/*/node_modules/
apps/*/dist/
apps/*/.vite/
*.tsbuildinfo

# Desktop packaging artifacts (unit 024): frozen sidecar + installer — never commit
apps/desktop/sidecar/build/
apps/desktop/sidecar/dist/
apps/desktop/release/

# Desktop emitted bundles and local delivery scratch (unit 078) — never commit.
# Untracked but unignored, these were a bulk-`git add` hazard and made Ruff and
# Vitest collect stale copies of the workspace from local packaging runs.
apps/*/dist-electron/
apps/desktop/.build/

# Agent worktrees checked out inside the tree — never repo content. Git already
# excludes them locally, but the sdist builder reads .gitignore, so without this
# `uv build` walks a sibling checkout and fails on its leftover temp paths.
.claude/worktrees/

# Local manual-QA helper (docs/manual-qa.md §2) — do not commit
/serve_web_demo.py

# Local agent / browser-QA scratch artifacts — never commit
/.playwright-mcp/
/.claude/skills/run-web-demo/

# Logs / runtime files (root-anchored so source packages are not caught)
/logs/
/tmp/
/artifacts/
/.pytmp/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local legacy OpenSpec reference - do not commit raw internal specs
openspec/
sensitive-scan.txt
