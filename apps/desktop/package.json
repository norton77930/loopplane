{
  "name": "@loopplane/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LoopPlane desktop GUI — Electron shell over a local sidecar with shared cowork presentation (078).",
  "main": "dist-electron/main.js",
  "files": [
    "dist",
    "dist-electron",
    "electron-builder.yml",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build:sidecar": "pwsh -NoProfile -File ../../../scripts/build-desktop-sidecar.ps1",
    "dist": "electron-builder",
    "package": "pwsh -NoProfile -File ../../../scripts/build-desktop-package.ps1"
  },
  "dependencies": {
    "@loopplane/cowork-presentation": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
