{
  "name": "@loopplane/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LoopPlane desktop GUI — an Electron shell over a local sidecar, reusing the web UI (unit 019).",
  "main": "electron/main.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build:sidecar": "pyinstaller sidecar/loopplane-sidecar.spec --distpath sidecar/dist --workpath sidecar/build",
    "dist": "electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
