{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "paths": {
      "@web/*": ["../web/src/*"],
      "@loopplane/cowork-presentation": [
        "../../packages/cowork-presentation/src/index.ts"
      ],
      "@loopplane/cowork-presentation/*": [
        "../../packages/cowork-presentation/src/*"
      ]
    }
  },
  "include": ["src", "electron", "vite.config.ts"]
}
